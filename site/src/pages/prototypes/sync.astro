---
import Base from '../../layouts/Base.astro'

const title = 'Sync screen prototype · LapCraft'
const description = 'Mockup of the sync screen with a filmstrip and coarse seek, for design review.'
---

<Base title={title} description={description} path="/prototypes/sync" noindex={true}>
  <meta name="robots" content="noindex, nofollow" />

  <style>
    .proto-wrap { max-width: 1080px; margin: 0 auto; padding: 24px 16px 64px; }
    .proto-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 20px; }
    .proto-controls label { font-size: 0.85rem; color: var(--subtext); }
    .proto-controls button, .proto-controls select {
      font: inherit; font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;
      border: 1px solid var(--surface1); background: var(--surface0); color: var(--text); cursor: pointer;
    }
    .proto-controls button.active { background: var(--mint); color: var(--mint-on); border-color: var(--mint); }
    .proto-stage { display: flex; justify-content: center; }
    .phone {
      width: 393px; max-width: 100%; background: var(--crust); border: 2px solid var(--surface1);
      border-radius: 36px; padding: 14px; box-shadow: var(--shadow); position: relative;
    }
    .phone::before { content: ''; position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
      width: 64px; height: 6px; border-radius: 3px; background: var(--surface1); }
    .screen { background: var(--base); border-radius: 22px; padding: 14px; min-height: 760px; color: var(--text); font-family: var(--sans); }
    .screen-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .back { color: var(--mint); font-size: 1.2rem; }
    .screen-title { font-weight: 700; font-size: 1.05rem; }
    .screen-sub { font-size: 0.8rem; color: var(--subtext); margin-left: auto; }
    .video {
      aspect-ratio: 16/9; background: linear-gradient(135deg, #1a2226 0%, #0a0e10 100%);
      border-radius: 22px; overflow: hidden; position: relative; margin-bottom: 6px;
      display: flex; align-items: center; justify-content: center;
    }
    .video .play { width: 44px; height: 44px; border-radius: 50%; background: rgb(255 255 255 / 0.12);
      display: grid; place-items: center; color: var(--text); font-size: 1.1rem; }
    .video .badge { position: absolute; top: 8px; left: 10px; font: 10px/1 var(--mono); color: var(--subtext);
      background: rgb(0 0 0 / 0.4); padding: 3px 6px; border-radius: 6px; }
    .filmstrip { display: flex; gap: 6px; overflow-x: auto; padding: 6px 2px; margin-bottom: 8px;
      scrollbar-width: none; }
    .filmstrip::-webkit-scrollbar { display: none; }
    .thumb {
      flex: 0 0 64px; height: 40px; border-radius: 8px; border: 2px solid transparent; cursor: pointer;
      background: linear-gradient(135deg, #2a3a42, #0a0e10); position: relative; overflow: hidden;
      display: flex; align-items: flex-end; padding: 3px;
    }
    .thumb.current { border-color: var(--mint); box-shadow: 0 0 0 2px var(--mint); }
    .thumb .t { font: 9px/1 var(--mono); color: var(--text); text-shadow: 0 1px 2px #000; }
    .thumb .bar { position: absolute; left: 0; bottom: 0; height: 3px; background: var(--mint); opacity: 0.7; }
    .line { font-size: 0.85rem; font-weight: 600; margin: 4px 0; }
    .line .accent { color: var(--cyan); }
    .caption { font-size: 0.72rem; color: var(--subtext); margin-bottom: 10px; }
    .footer { background: var(--mantle); border: 1px solid var(--surface0); border-radius: 12px;
      padding: 8px 10px; margin-bottom: 12px; }
    .footer-row { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
    .clock { font: 11px/1 var(--mono); color: var(--text); }
    .clock .end { color: var(--subtext); }
    .ruler { height: 28px; background: var(--surface0); border-radius: 8px; position: relative; overflow: hidden; }
    .ruler .needle { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--mint); left: 50%; }
    .transport { display: flex; justify-content: center; gap: 6px; margin-top: 6px; }
    .transport button { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--surface1);
      background: var(--surface0); color: var(--text); cursor: pointer; font-size: 0.85rem; }
    .transport button.primary { background: var(--mint); color: var(--mint-on); border-color: var(--mint); width: 44px; height: 44px; }
    .card { background: var(--mantle); border: 1px solid var(--surface0); border-radius: 12px;
      padding: 12px; margin-bottom: 10px; }
    .card h3 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--subtext); margin: 0 0 6px; }
    .card .title { font-size: 0.95rem; font-weight: 600; margin-bottom: 2px; }
    .card .body { font-size: 0.75rem; color: var(--subtext); margin-bottom: 8px; line-height: 1.35; }
    .metric { display: flex; justify-content: space-between; font-size: 0.78rem; padding: 2px 0; }
    .metric .v { font-family: var(--mono); color: var(--text); }
    .field { width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--surface1);
      background: var(--surface0); color: var(--text); font-size: 0.85rem; margin-bottom: 6px; }
    .pill { display: inline-block; padding: 8px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
      border: 1px solid var(--surface1); background: var(--surface0); color: var(--text); cursor: pointer; }
    .pill.primary { background: var(--mint); color: var(--mint-on); border-color: var(--mint); width: 100%; text-align: center; box-sizing: border-box; }
    .pill.ghost { background: transparent; }
    .row { display: flex; gap: 8px; }
    .row .pill { flex: 1; }
    .save-row { display: flex; gap: 8px; padding-top: 10px; border-top: 1px solid var(--hairline); }
    .save-row .pill { flex: 1; }
    .note { font-size: 0.7rem; color: var(--muted); margin-top: 6px; line-height: 1.35; }
    .hint-bar { font-size: 0.72rem; color: var(--mint); margin: 4px 0 8px; }
  </style>

  <div class="proto-wrap">
    <div class="proto-controls">
      <label>Strip</label>
      <button id="btn-whole" class="active">Whole clip</button>
      <button id="btn-loupe">Around this frame</button>
      <label style="margin-left:12px">Start error</label>
      <select id="err">
        <option value="0">correct (0 s)</option>
        <option value="2">+2 s</option>
        <option value="10" selected>+10 s</option>
        <option value="20">+20 s</option>
      </select>
      <label style="margin-left:12px">Decode</label>
      <button id="btn-ready" class="active">ready</button>
      <button id="btn-loading">loading…</button>
    </div>

    <div class="proto-stage">
      <div class="phone">
        <div class="screen" id="screen">
          <div class="screen-header">
            <span class="back">←</span>
            <span class="screen-title">Sync clip</span>
            <span class="screen-sub">Lap 3 · 1:36.131</span>
          </div>

          <div class="video">
            <span class="badge" id="badge">0:12.140 / 1:40.000</span>
            <div class="play">▶</div>
          </div>

          <div class="filmstrip" id="strip"></div>

          <div class="line" id="line">54.2% lap · <span class="accent">187 km/h</span></div>
          <div class="caption">The lap start is the first frame of the lap. The replay and telemetry both start there.</div>

          <div class="footer">
            <div class="footer-row">
              <span class="clock">Clip <span id="clock">0:12.140</span> / 1:40.000</span>
              <span style="margin-left:auto;font:11px var(--mono);color:var(--subtext)">1×</span>
              <span style="font:11px var(--mono);color:var(--subtext);margin-left:6px">↻</span>
            </div>
            <div class="ruler"><div class="needle"></div></div>
            <div class="transport">
              <button>−1</button>
              <button>⏮</button>
              <button class="primary">▶</button>
              <button>⏭</button>
              <button>+1</button>
            </div>
          </div>

          <div class="card">
            <h3>1 · Lap start</h3>
            <div class="title">The first frame of the lap</div>
            <div class="body">The clip starts on this frame and runs for one lap (1:36.131). The telemetry is cut to the same window.</div>
            <div class="metric"><span>Lap start</span><span class="v" id="ls">0:12.140</span></div>
            <div class="hint-bar" id="hint">The app picked this frame one lap back from the clip end. Check the HUD timer has just restarted, or set the lap start again.</div>
            <input class="field" placeholder="Timer on this frame (optional)" value="" />
            <div class="note">Starts on the line at 0:12.140 · ends 0:13.736</div>
            <button class="pill ghost" style="width:100%;margin-bottom:6px">How to find the lap start</button>
            <button class="pill primary" id="use-frame">Use this frame</button>
          </div>

          <div class="card">
            <h3>2 · Finish frame</h3>
            <div class="metric"><span>Lap start</span><span class="v">0:12.140</span></div>
            <div class="metric"><span>Finish frame</span><span class="v">0:13.736</span></div>
            <div class="metric"><span>Lap</span><span class="v">1:36.131</span></div>
            <div class="row" style="margin-top:8px">
              <button class="pill ghost" id="go-end">Go to end</button>
              <button class="pill ghost" id="use-finish">Use this frame as finish</button>
            </div>
            <div class="note">The end of the clip lands back on the line, one lap after the lap start.</div>
          </div>

          <div class="card">
            <h3>Replay quality</h3>
            <div class="metric"><span>Estimated size</span><span class="v">≈ 41 MB</span></div>
            <div class="note">Set a lap start to estimate the stored size.</div>
          </div>

          <div class="save-row">
            <button class="pill ghost">Discard</button>
            <button class="pill primary">Save clip</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const DUR = 100; // seconds
      const SPAN = 96.131; // seconds
      const THUMB_W = 64;
      const strip = document.getElementById('strip');
      const clock = document.getElementById('clock');
      const badge = document.getElementById('badge');
      const ls = document.getElementById('ls');
      const hint = document.getElementById('hint');
      const useFrame = document.getElementById('use-frame');

      let mode = 'whole'; // 'whole' | 'loupe'
      let startError = 10; // seconds the default is off by
      let current = Math.max(0, DUR - SPAN - startError); // seconds, where the lap start actually sits
      let loading = false;

      function fmt(s) {
        const m = Math.floor(s / 60);
        const sec = s % 60;
        return m + ':' + sec.toFixed(3).padStart(6, '0');
      }

      function timesFor(mode, center) {
        const out = [];
        if (mode === 'whole') {
          const n = 16;
          for (let i = 0; i < n; i++) out.push((i / (n - 1)) * DUR);
        } else {
          const n = 9;
          const half = 4;
          for (let i = 0; i < n; i++) {
            const t = center + (i - (n - 1) / 2) * (half * 2 / (n - 1));
            out.push(Math.min(DUR, Math.max(0, t)));
          }
        }
        return out;
      }

      function hueFor(t) {
        // fake motion: brighter in the middle of straights
        const v = 30 + 40 * Math.sin(t * 0.7 + 1.2) * Math.sin(t * 0.7 + 1.2);
        return Math.round(v);
      }

      function render() {
        strip.innerHTML = '';
        if (loading) {
          const d = document.createElement('div');
          d.style.cssText = 'flex:1;text-align:center;padding:12px 0;color:var(--subtext);font-size:0.75rem;';
          d.textContent = 'Decoding frames…';
          strip.appendChild(d);
          return;
        }
        const times = timesFor(mode, current);
        times.forEach((t) => {
          const el = document.createElement('div');
          el.className = 'thumb' + (Math.abs(t - current) < 0.6 ? ' current' : '');
          el.innerHTML = '<span class="t">' + fmt(t) + '</span><div class="bar" style="width:' + hueFor(t) + '%"></div>';
          el.addEventListener('click', () => { current = t; render(); updateReadouts(); });
          strip.appendChild(el);
        });
      }

      function updateReadouts() {
        const f = fmt(current);
        clock.textContent = f;
        badge.textContent = f + ' / 1:40.000';
        ls.textContent = f;
        useFrame.onclick = () => {};
      }

      function updateHint() {
        if (startError === 0) {
          hint.textContent = 'The app found a frame that lines up with the telemetry. Confirm with Use this frame, or nudge with −1/+1.';
          hint.style.color = 'var(--mint)';
        } else {
          hint.textContent = 'Default is ' + startError + ' s off. Tap a thumb near the line, then Use this frame.';
          hint.style.color = 'var(--amber)';
        }
      }

      document.getElementById('btn-whole').addEventListener('click', (e) => {
        mode = 'whole'; e.target.classList.add('active');
        document.getElementById('btn-loupe').classList.remove('active');
        render();
      });
      document.getElementById('btn-loupe').addEventListener('click', (e) => {
        mode = 'loupe'; e.target.classList.add('active');
        document.getElementById('btn-whole').classList.remove('active');
        render();
      });
      document.getElementById('err').addEventListener('change', (e) => {
        startError = parseInt(e.target.value, 10);
        current = Math.max(0, DUR - SPAN - startError);
        updateHint();
        render(); updateReadouts();
      });
      document.getElementById('btn-ready').addEventListener('click', (e) => {
        loading = false; e.target.classList.add('active');
        document.getElementById('btn-loading').classList.remove('active');
        render();
      });
      document.getElementById('btn-loading').addEventListener('click', (e) => {
        loading = true; e.target.classList.add('active');
        document.getElementById('btn-ready').classList.remove('active');
        render();
      });
      document.getElementById('use-finish').addEventListener('click', () => {
        current = Math.max(0, current - 0); // placeholder: finish anchor sets start = frame - span
        // demo: pretend we picked a finish frame 2s from the end
        current = DUR - 2 - SPAN;
        render(); updateReadouts();
      });
      document.getElementById('go-end').addEventListener('click', () => {
        current = DUR - 2; render(); updateReadouts();
      });

      updateHint();
      render();
      updateReadouts();
    })();
  </script>
</Base>
