<style>
  .footer-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--surface1);
    border-radius: 10px;
    color: var(--subtext);
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .footer-link:hover {
    color: var(--text);
    border-color: var(--mint);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .footer-link svg { width: 16px; height: 16px; flex: 0 0 auto; }
</style>