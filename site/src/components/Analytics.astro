---
import ConsentBanner from '../islands/ConsentBanner.svelte'
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN
---
<!-- Consent Mode v2 defaults: deny until the user opts in. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ window.dataLayer.push(arguments); }
  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500
  });
</script>

{beacon && (
  <script is:inline define:vars={{ token: beacon }}>
    // Preview URLs and localhost would only add noise, and the beacon's CORS
    // preflight fails off the production host.
    if (location.hostname === 'lapcraft.jlai.ca') {
      var s = document.createElement('script');
      s.defer = true;
      s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      s.setAttribute('data-cf-beacon', JSON.stringify({ token: token }));
      document.head.appendChild(s);
    }
  </script>
)}

<ConsentBanner client:load />